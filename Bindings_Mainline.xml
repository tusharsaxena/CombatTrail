<Bindings>
	<!-- Retail's key bindings: the client prefers this flavor-suffixed file over Bindings.xml and
	     reads only one, so this holds Bindings.xml's three in its order with the Retail-only Toggle
	     Race window key after Results (a documented deviation, docs/ARCHITECTURE.md: toc-file-§3,
	     layout-§1, launcher-§6). WoW Forever reads Bindings.xml and never lists the Race key
	     (clients-§4). Bindings.xml's comment rules both files; the two MUST stay in step
	     (tests/test_bindings.lua). The buttons, labels and NS.BINDINGS are core/LauncherSetup.lua's,
	     the Race key's created on Retail only. Not listed in the TOC. -->
	<Binding name="CLICK CombatTrailToggleHud:LeftButton" category="BINDING_HEADER_COMBATTRAIL"/>
	<Binding name="CLICK CombatTrailToggleResults:LeftButton" category="BINDING_HEADER_COMBATTRAIL"/>
	<Binding name="CLICK CombatTrailToggleRace:LeftButton" category="BINDING_HEADER_COMBATTRAIL"/>
	<Binding name="CLICK CombatTrailToggleLanes:LeftButton" category="BINDING_HEADER_COMBATTRAIL"/>
</Bindings>
