## Interface: 120105, 16001
## Title: Ka0s Combat Trail
## Notes: Your casts as a scrolling trail, a live DPS HUD on every fight, and a history of your fights.
## Author: add1kted2ka0s
## Version: 0.1.0
## IconTexture: Interface\AddOns\CombatTrail\media\logos\combattrail.logo.128.tga
## SavedVariables: CombatTrailDB, CombatTrailPerfDB
## OptionalDeps: Ace3, LibStub, CallbackHandler-1.0, LibSharedMedia-3.0, LibDataBroker-1.1, LibDBIcon-1.0, EllesmereUI
## DefaultState: enabled
## Category-enUS: Combat
## X-License: MIT
## X-Standard: https://github.com/tusharsaxena/WowAddonStandards
# X-Curse-Project-ID: not published on CurseForge yet

# Libraries (must load first) -- vendored in libs/, .xml where the lib ships one, else .lua. The Ace3,
# LibSharedMedia, LibDataBroker and LibDBIcon copies are Panel Master's, the set that loads on both
# Retail and WoW Forever.
libs\LibStub\LibStub.lua
libs\CallbackHandler-1.0\CallbackHandler-1.0.lua
libs\AceAddon-3.0\AceAddon-3.0.lua
libs\AceEvent-3.0\AceEvent-3.0.lua
libs\AceTimer-3.0\AceTimer-3.0.lua
libs\AceDB-3.0\AceDB-3.0.lua
libs\AceDBOptions-3.0\AceDBOptions-3.0.lua
libs\AceConsole-3.0\AceConsole-3.0.lua
libs\AceGUI-3.0\AceGUI-3.0.xml
libs\AceConfig-3.0\AceConfig-3.0.xml
# ONE line: the .xml is itself the file list (library-stack-§7). After Ace3.
libs\LibKa0s\LibKa0s.xml
libs\LibSharedMedia-3.0\lib.xml
libs\LibDataBroker-1.1\LibDataBroker-1.1.lua
libs\LibDBIcon-1.0\lib.xml

# Locales
# LOAD-BEARING: creates NS.L, which core\LifecycleSetup.lua, core\DebugLogSetup.lua and
# core\LauncherSetup.lua read at FILE SCOPE.
locales\enUS.lua

# Core -- dependency-correct order (layout-§1). Every LOAD-BEARING note says what resolves at load;
# core\State.lua, core\Bus.lua, core\PoolSetup.lua and core\Database.lua are conventional and may
# move within the group (nothing else in core\ reads them at FILE SCOPE).
# LOAD-BEARING: publishes NS.PREFIX, NS.name, NS.BRAND, the slash words and the version fallback every
# file below reads.
core\Namespace.lua
# LOAD-BEARING: publishes NS.MediaFont, which core\Constants.lua resolves FONT_MONO from at FILE SCOPE.
core\MediaSetup.lua
core\Constants.lua
core\State.lua
# LOAD-BEARING: resolves NS.version at FILE SCOPE (needs core\Namespace.lua's fallback), and
# core\PerfSetup.lua calls NS.Version() at FILE SCOPE, so this precedes it.
core\EnvSetup.lua
# LOAD-BEARING: after NS.PREFIX, before anything that prints; publishes NS.Util.print, which
# core\CombatTrail.lua reclaims at FILE SCOPE, and NS.LIBKA0S_MISSING, which the stubs below read.
core\CoreSetup.lua
# LOAD-BEARING: the LibKa0s-Skin-1.0 seam (skinning-§1). Registers the owner at FILE SCOPE (before
# EllesmereUI dispatches its skins) and publishes NS.Skin and NS.DEFAULT_SKIN, which
# defaults\Profile.lua reads at FILE SCOPE; every frame-building file reads NS.Skin, so it sits above
# core\WidgetsSetup.lua and every module. Below core\CoreSetup.lua, whose NS.ApplySkin the degraded
# facade's Shell calls and whose NS.Print the reload line uses (both at CALL time).
core\SkinSetup.lua
# LOAD-BEARING: the compat family's root (compat). Resolves LibKa0s-Compat-1.0 at FILE SCOPE and
# publishes NS.Compat, whose guards core\Secrets.lua binds at FILE SCOPE; modules read it at CALL time.
core\Compat.lua
# LOAD-BEARING: after core\Compat.lua. Resolves LibKa0s-Sim-1.0 at FILE SCOPE and walks NS.Compat's
# members into its seam there.
core\SimSetup.lua
# LOAD-BEARING: after core\Compat.lua (binds its guards at FILE SCOPE); publishes NS.Secrets, which
# the meter reader captures at FILE SCOPE, so it sits before the modules.
core\Secrets.lua
core\Bus.lua
core\PoolSetup.lua
# Reads LibStub (LibKa0s-Widgets-1.0) at FILE SCOPE and NS.Icon at CALL time only.
core\WidgetsSetup.lua
# LOAD-BEARING: core\PerfSetup.lua hands NS.lifecycle to LibKa0s-Perf-1.0, which RAISES at :New
# without it, so the latch is built first.
core\LifecycleSetup.lua
# LOAD-BEARING: before any module taking NS.Perf as a load-time upvalue.
core\PerfSetup.lua
# LOAD-BEARING: after core\Constants.lua (FONT_MONO), core\State.lua (the flag) and core\CoreSetup.lua
# (the printer), before any NS.Debug call.
core\DebugLogSetup.lua
# LOAD-BEARING: reads NS.Constants.LOGO_128 and NS.L at FILE SCOPE (the library raises on a launcher
# with no icon). Everything else it names is resolved at CALL time.
core\LauncherSetup.lua
# LOAD-BEARING: promotes NS to the AceAddon object and reclaims NS.Print from NS.Util.print at FILE
# SCOPE, so it follows core\CoreSetup.lua.
core\CombatTrail.lua
core\Database.lua

# Defaults (the only place a default is hardcoded -- savedvariables-§2)
# Each lane's ignored spells, per client. LOAD-BEARING: reads NS.Compat at FILE SCOPE and publishes
# NS.IGNORE_SEEDS, which defaults\Profile.lua reads at FILE SCOPE.
defaults\IgnoreSeeds.lua
# LOAD-BEARING: reads NS.DEFAULT_SKIN (core\SkinSetup.lua), NS.L and NS.IGNORE_SEEDS at FILE SCOPE.
defaults\Profile.lua
# The training dummies, per client. LOAD-BEARING: reads NS.Compat at FILE SCOPE and publishes
# NS.DUMMIES; modules\Identity.lua reads it at CALL time.
defaults\Dummies.lua

# Modules -- conventional order: each reaches the others at CALL time, except as noted.
# The lanes' cast capture. LOAD-BEARING: captures NS.Secrets and NS.Perf and registers its bus
# receiver (core\Bus.lua) at FILE SCOPE; reaches NS.db at CALL time only.
modules\LaneCasts.lua
# The lanes' layout math: pure, read by modules\LaneRender.lua at CALL time.
modules\LaneLayout.lua
# The lanes' frames. LOAD-BEARING: captures NS.Pool, NS.Secrets, NS.Perf and NS.LaneLayout and
# registers its bus receiver (core\Bus.lua) at FILE SCOPE, so it follows modules\LaneLayout.lua;
# reaches NS.db and NS.LaneCasts at CALL time only.
modules\LaneRender.lua
# Where each lane sits (free, docked, on a unit frame), its strata and level, and the edit overlay.
# LOAD-BEARING: captures NS.Secrets and NS.Constants.LAYERS and registers its bus receiver at FILE
# SCOPE; reaches NS.LaneRender, NS.LaneVisibility and NS.db at CALL time only.
modules\LaneAnchor.lua
# When each lane shows, and its opacity. LOAD-BEARING: captures NS.Secrets and registers its bus
# receiver at FILE SCOPE; reaches NS.LaneRender, NS.LaneAnchor and NS.db at CALL time only.
modules\LaneVisibility.lua
modules\LaneIgnore.lua
# The ONLY reader of C_DamageMeter. LOAD-BEARING: captures NS.Secrets and NS.Perf and resolves the
# meter enums at FILE SCOPE; registers nothing (core\CombatTrail.lua primes its session list).
modules\Meter.lua
# `/kct probe`: the in-game checks of the meter, the casts and the pet. Registers nothing until armed;
# reaches NS.Meter, NS.DebugLog, NS.Compat and NS.db at CALL time only.
modules\Probe.lua
# Who, where and against what a fight was, and its board key. Captures NS.Secrets and NS.L at FILE
# SCOPE; reaches NS.Compat and NS.DummyName at CALL time only.
modules\Identity.lua
# The fight state machine: idle -> combat -> settling, bound to the meter's sessions. LOAD-BEARING:
# captures NS.Secrets and NS.Constants.FIGHT at FILE SCOPE; reaches NS.Meter, NS.Watchers and NS.addon
# (its AceTimers) at CALL time only.
modules\Fight.lua
# The fight's event wiring, one set per fight state. Captures NS.Perf at FILE SCOPE; reaches NS.Fight
# at CALL time only.
modules\Watchers.lua
# The stored cast list's format: pure.
modules\CastCodec.lua
# Each fight's cast list. LOAD-BEARING: calls NS.LaneCasts.Listen and registers its bus receiver at FILE
# SCOPE, so it follows modules\LaneCasts.lua; captures NS.Secrets and NS.Perf there too.
modules\Casts.lua
# What a fight used, the stats and the loadout it was fought with. Each captures NS.Secrets and
# registers its bus receiver at FILE SCOPE; reaches the client and NS.db at CALL time only.
modules\Usage.lua
modules\Stats.lua
modules\Loadouts.lua
# The recording filters, the bests and the store: pure over the settings and the stored records.
# Bests and Recorder each register their bus receiver at FILE SCOPE; Recorder captures NS.Secrets and
# NS.L there. Each reaches the others, NS.db and the fight modules above at CALL time only.
modules\Filters.lua
modules\Bests.lua
modules\Recorder.lua
# The purge (at login, daily, `/kct purge`) and the store's size. Reaches NS.Recorder, NS.Bests,
# NS.Loadouts and NS.db at CALL time only; its daily timer is the addon object's AceTimer.
modules\Retention.lua
modules\Slices.lua
# The DPS HUD (spec §6). Format first: the HUD's files reach it at call time, as they reach each other.
modules\Format.lua
# LOAD-BEARING: the shared look. NS.Skin.OnLooksChanged is registered and the live colors are built at
# FILE SCOPE (core\SkinSetup.lua); the HUD's files capture NS.Style at FILE SCOPE.
modules\Style.lua
# The HUD's look. LOAD-BEARING: registers its NS.Style.OnLooks listener at FILE SCOPE, so it follows
# modules\Style.lua; reaches NS.Hud and NS.db at CALL time only.
modules\Hud_Appearance.lua
# The HUD's tooltips' words, the pace data, the spell rows and the chart with the pace bar: each
# captures NS.L, NS.Style or NS.Secrets at FILE SCOPE and reaches the others at CALL time only.
modules\Hud_Tips.lua
modules\Hud_Best.lua
modules\Hud_Breakdown.lua
modules\Hud_Chart.lua
# The HUD's bodies: capture NS.Style and NS.Secrets at FILE SCOPE.
modules\Hud_States.lua
# LOAD-BEARING: builds its bus receiver (FIGHT_* / SETTINGS_CHANGED) at FILE SCOPE through core\Bus.lua
# and captures NS.Perf and NS.Secrets there; reaches NS.HudStates, NS.Meter, NS.Identity, NS.Bests,
# NS.Recorder and NS.db at CALL time only.
modules\Hud.lua

# Settings (last -- depend on everything else being initialized)
# LOAD-BEARING: publishes NS.RegisterSchemaRows, NS.GetSetting and NS.SetByPath, which settings\General.lua
# calls at FILE SCOPE and core\LifecycleSetup.lua's NS.SyncEnabledHold reads at CALL time.
settings\Schema.lua
settings\Slash.lua
# LOAD-BEARING: publishes NS.Helpers, which every page file below captures at FILE SCOPE, and
# NS.RegisterTabbedPage, which settings\Lanes.lua, Hud.lua and History.lua call at FILE SCOPE.
settings\OptionsSetup.lua
# LOAD-BEARING: General registers FIRST and Profiles LAST -- the page order IS the registration order
# (General, Lanes, DPS HUD, History, Profiles).
settings\General.lua
settings\Lanes.lua
settings\Hud.lua
settings\History.lua
settings\Profiles.lua
